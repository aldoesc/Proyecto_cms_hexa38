# Copia este archivo como ".env" (junto a docker-compose.yml) y pon valores propios.
# El .env NO se sube al repositorio.

# Clave de sesiones del panel. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clave que usan los tótems. Debe ser IDÉNTICA al "api_key" de config_totem.json
# en cada tótem.
API_KEY=

# Zona horaria del panel y de los registros
TZ=America/Lima
